[Unit]
Description=tinygrad server - Qwen3.8-27B on the tiny chestnut (USB3) - amd-gemv-qwen38-jacob
After=network-online.target cpu-performance-tuning.service
# Wants=, never Requires=: if the tuning unit fails the server must still start. That cascade
# is exactly what broke the M8 (gpu-power-tuning.service + Requires=).
Wants=network-online.target cpu-performance-tuning.service
# NOTE: deliberately no Requires=gpu-power-tuning.service. That unit writes
# /sys/bus/pci/devices/0000:03:00.0/power_dpm_force_performance_level, an *amdgpu*
# attribute on the M8's OCuLink slot. On the chestnut the GPU never appears on the host
# PCI bus and amdgpu never binds, so that write can never succeed -- it would burn its
# 30s retry loop, fail, and (via Requires=) stop this unit from ever starting.
# The equivalent knob here is AM_POWER_LIMIT (watts) below; tinygrad's AM driver does its
# own SMU init and sets the GPU's performance state itself.
Conflicts=llama-server.service tinygrad-server.service tinygrad-server-jacob.service tinygrad-server-splizard.service tinygrad-server-splizard-iq3.service tinygrad-server-gguf.service

[Service]
Type=simple
User=jacob
# NOT the source checkout: cwd shadows site-packages on sys.path, so a repo cwd would silently
# run whatever is checked out instead of the installed copy -- the exact fragility this removes.
WorkingDirectory=/home/jacob

# The venv at ~/z/tinygrad-serve is a NON-EDITABLE `pip install ~/z/tinygrad` -- a frozen copy in
# site-packages. Branch checkouts, pulls and edits in the source repo cannot touch the running
# server or invalidate its LLM_CACHE. To deploy new code:
#   /home/jacob/z/tinygrad-serve/bin/pip install --force-reinstall --no-deps /home/jacob/z/tinygrad
#   cd / && /home/jacob/z/tinygrad-serve/bin/python3 -c "import tinygrad.llm.cli"   # VERIFY before restarting
#   sudo systemctl restart tinygrad-server-chestnut     (one cold compile per deploy)
# The verify step exists because the first freeze shipped without tinygrad.llm.kernels (new
# subpackage, absent from pyproject's explicit package list and lacking __init__.py) and the
# service crash-looped 22 times on ModuleNotFoundError. Packaging fixed since, but any future
# new subpackage has the same failure mode: import the entry module from a neutral cwd first.
# USB+ selects USBIface explicitly. Without it, AMDDevice.ifaces is tried KFD -> PCI -> USB
# and would still find the dock by fallback, but only after two failed probes -- be explicit.
# :LLVM stays mandatory for this fork's raw-LLVM-IR gemv kernels (sweeps/README.md).
Environment=DEV=USB+AMD:LLVM
Environment=LLM_CACHE=1
Environment=PYTHONUNBUFFERED=1
# Optional: cap GPU power (watts). Replaces the sysfs power_dpm_* tuning, which is unavailable here.
# Environment=AM_POWER_LIMIT=250

# Device access is via libusb, not a kernel driver: /etc/udev/rules.d/99-tinygrad-usbgpu.rules
# grants the `plugdev` group access to 3801:0001 (comma VID, chestnut custom firmware).
# No amdgpu, no thunderbolt authorization, no BIOS changes, no connect-before-boot needed.
ExecStart=/home/jacob/z/tinygrad-serve/bin/python3 -m tinygrad.llm.cli \
  --model /home/jacob/models/Qwen3.8-27B-UD-Q4_K_XL.gguf \
  --mmproj none \
  --repeat-penalty 1.15 \
  --max_context 131072 \
  --host 0.0.0.0 \
  --serve 8080

Restart=on-failure
RestartSec=5
# cli.py drains the GPU queues on SIGTERM and exits 128+15=143; without this every
# stop/restart is logged as "Failed with result 'exit-code'".
SuccessExitStatus=143
# First start on a cold LLM_CACHE key is a ~9 min compile; don't let systemd give up.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target

 213   for (u32 rtt = 0; rtt < 3; rtt++) {
 214     BAR();
 215     if (rt == rtt) {
 216       #pragma unroll
 217       for (int dt = 0; dt < 8; dt++)
 218         #pragma unroll
 219         for (int i = 0; i < 8; i++) Os[(2 * i + h) * 256 + dh * 128 + dt * 16 + l16] = O[dt][i] * l[i];
 220     }
 221     wht_vecs(Os, 16, t);
 222     for (u32 b = wave; b < 32; b += 6) {  // one wave per 128-block: row rr, half hf
 223       const u32 rr = b >> 1, hf = b & 1, r = rtt * 16 + rr, tl = r / 6, hh = r % 6;
 224       if (tl >= nq) continue;
 225       const u64 tok = qt0 + tl, head = 6 * kvh + hh, e0 = (tok * 24 + head) * 256 + hf * 128;
 226       float y[4], a = 0.0f;
 227       #pragma unroll
 228       for (int c = 0; c < 4; c++) {
 229         const u32 d = hf * 128 + c * 32 + lane;
 230         float v = (kv_sgn(d, 19088743u) ? -Os[rr * 256 + d] : Os[rr * 256 + d]) * (1.0f / 16.0f);
 231         const float g = q_raw[(tok * 24 + head) * 512 + 256 + d]; v *= 1.0f / (1.0f + __builtin_expf(-g));
 232         y[c] = v; out[e0 + c * 32 + lane] = v; a = __builtin_fmaxf(a, __builtin_fabsf(v));
 233       }
 234       a = __builtin_fmaxf(a, dpp_shr(a, 0x111)); a = __builtin_fmaxf(a, dpp_shr(a, 0x112));
 235       a = __builtin_fmaxf(a, dpp_shr(a, 0x114)); a = __builtin_fmaxf(a, dpp_shr(a, 0x118));
 236       const float mx = __builtin_fmaxf(read_lane(a, 15), read_lane(a, 31));
 237       const float dq = mx / 127.0f, id = dq != 0.0f ? 1.0f / dq : 0.0f;
 238       #pragma unroll
 239       for (int c = 0; c < 4; c++) {
 240         const u64 e = e0 + c * 32 + lane;
 241         const i32 qi = (i32)__builtin_rintf(y[c] * id);
 242         oq[e] = (i8)qi;
 243         const float sq = row_sum16((float)qi);
 244         if (lane == 15) osum16[(e >> 5) * 2] = dq * sq;
 245         if (lane == 31) osum16[(e >> 5) * 2 + 1] = dq * sq;
 246       }
 247       if (lane == 31) os[e0 >> 7] = dq;
 248     }
 249   }
 250 #endif
 251 }
